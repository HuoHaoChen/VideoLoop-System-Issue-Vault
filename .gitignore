# =============================================================================
# VideoLoop .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# --- macOS ---
.DS_Store
._*

# --- Secrets (keep .example files) ---
.env
*.env
!*.env.example
config/hermes.env

# --- Backups (generated by scripts/backup.py) ---
backups/

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/

# --- OS junk ---
Thumbs.db
Desktop.ini

# --- Hermes runtime artifacts ---
.hermes/
